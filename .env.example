# Copy to .env and fill in real values for local development.
# Never commit the real .env file (see .gitignore).

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=loony_shazam
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------
REDIS_PORT=6379

# --- Processor (Python fingerprint extraction service) ------------------
PROCESSOR_PORT=8001
PROCESSOR_URL=http://localhost:8001

# --- Backend (Rust API) --------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/loony_shazam
REDIS_URL=redis://localhost:6379
RUST_LOG=info,sqlx=warn

MAX_AUDIO_BYTES=20971520
MAX_AUDIO_DURATION_SECONDS=15
FINGERPRINT_ALGORITHM_VERSION=1

# Required. Generate a real random value for anything beyond local dev,
# e.g.: openssl rand -hex 32
ADMIN_API_KEY=dev-admin-key-change-me

# Rate limiting (see backend/src/routes/rate_limit.rs)
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Matching engine thresholds (see docs/fingerprinting.md "Scoring")
MATCH_OFFSET_BUCKET_MS=100
MATCH_MIN_DOMINANT_VOTES=5
MATCH_MIN_SCORE=4.0
MATCH_MIN_COVERAGE=0.03
MATCH_MIN_MARGIN_RATIO=1.3
